NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
# Enable only after enabling IP Address Forwarding in Supabase Auth settings.
SUPABASE_AUTH_IP_FORWARDING_ENABLED=false
# Local: http://localhost:3210 | Production: https://grafi-calc.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3210
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
# Developer area: configure only in Vercel/server environments, never in client-exposed variables.
GRAFICALC_DEVELOPER_EMAIL=hprvisual@hotmail.com
GRAFICALC_DEVELOPER_USER_ID=
GRAFICALC_DEVELOPER_USERNAME=seu-usuario-dev
GRAFICALC_DEVELOPER_PASSWORD=use-uma-senha-forte-e-unica
GRAFICALC_SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
# Billing: keep disabled until the migration, terms, and Sandbox webhook are configured.
# Production Asaas endpoints are intentionally unavailable in this codebase.
GRAFICALC_BILLING_ENABLED=false
GRAFICALC_BILLING_ENFORCEMENT=false
GRAFICALC_ASAAS_ENVIRONMENT=sandbox
GRAFICALC_ASAAS_API_KEY=
GRAFICALC_ASAAS_WEBHOOK_TOKEN=
GRAFICALC_BILLING_PLANS_JSON=[]
# Set a distinct 32+ character secret in Vercel; protects the durable billing-event recovery worker.
CRON_SECRET=
