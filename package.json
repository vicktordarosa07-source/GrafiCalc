{
  "name": "graficalc-saas",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "prepare:legacy": "node scripts/prepare-legacy.mjs",
    "predev": "npm run prepare:legacy",
    "prebuild": "npm run prepare:legacy",
    "dev": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3210",
    "legacy": "node server.js",
    "check:legacy": "node --check server.js && node --check app.mjs && node --check input-format.mjs && node --check number-input.mjs",
    "test:security:stage3": "node scripts/security-stage3.test.cjs",
    "test:security:csp": "node --experimental-strip-types scripts/security-csp.test.mjs",
    "test:security:stage4": "node scripts/security-stage4.test.cjs",
    "test:security:stage5": "node scripts/security-stage5.test.cjs",
    "test:security:stage-final": "node scripts/security-stage-final.test.cjs",
    "test:workspace-policy": "node --experimental-strip-types scripts/workspace-policy.test.mjs",
    "test:calculation-base": "node scripts/calculation-base.test.mjs",
    "test:workspace-api": "node --env-file=.env.sandbox.local --use-system-ca scripts/workspace-api.integration.mjs",
    "test:workspace-api-guard": "node --test scripts/workspace-api-target.test.mjs",
    "check": "npm run check:legacy && tsc --noEmit",
    "test:collection-policy": "node --experimental-strip-types scripts/collection-policy.test.mjs",
    "test:sync-recovery": "node scripts/sync-recovery.test.cjs",
    "test:pricing-regression": "node scripts/pricing-regression.test.cjs",
    "test:next-smoke": "node scripts/next-smoke.cjs",
    "test:operational-regression": "node scripts/operational-regression.test.cjs",
    "test:input-formatting": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/input-formatting.test.mjs",
    "test:redirect-security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/redirect-security.test.mjs",
    "test:number-input": "node scripts/number-input.test.mjs",
    "test:mobile-navigation": "node scripts/mobile-navigation.test.cjs",
    "test:billing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/billing.test.mjs",
    "test:billing-postgres": "node scripts/billing-postgres.integration.test.mjs",
    "test:auth-ip-forwarding": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/auth-ip-forwarding.test.mjs",
    "test:auth-rate-limit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/auth-rate-limit.test.mjs",
    "test:session-secret": "node --test scripts/session-secret.test.mjs",
    "test:supabase-migrations": "node scripts/supabase-migrations.pglite.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
